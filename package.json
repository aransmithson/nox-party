{
  "name": "nox-party",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "server": "node server.js",
    "test:desktop": "electron . --smoke-test",
    "test:breakout-editor": "electron . --smoke-test --brick-editor-only",
    "test:projector": "electron . --smoke-test --projector-only",
    "test:sprites": "electron . --smoke-test --sprites-only",
    "check": "node scripts/check-syntax.cjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "A desktop projector party game with phone controllers and editable arenas",
  "engines": {
    "node": ">=24"
  }
}
